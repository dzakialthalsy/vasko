# Salin berkas ini menjadi .env.local lalu isi nilainya sendiri.
# JANGAN pernah menempelkan isi .env.local ke percakapan mana pun.
# Berkas .env.local sudah diabaikan git, jadi tidak akan ikut ter-commit.

# ---------------------------------------------------------------- basis data
# Alamat sambungan PostgreSQL.
# Neon: https://console.neon.tech, buat project lalu salin connection string.
# Pakai sslmode=verify-full, bukan sekadar require, agar sertifikat server
# ikut diverifikasi.
DATABASE_URL=

# ------------------------------------------------------- penyedia ekstraksi
# Menentukan model mana yang membaca dokumen kontrak.
#
#   openrouter  gratis, untuk pengembangan dan pengujian
#   anthropic   berbayar, untuk dokumen sungguhan dan demonstrasi
#
# Bila dikosongkan, penyedia dipilih dari kunci yang tersedia, dengan
# OpenRouter didahulukan.
EKSTRAKSI_PENYEDIA=openrouter

# ----------------------------------------------------------- OpenRouter
# PERINGATAN: endpoint gratis di OpenRouter gratis karena penyedia di
# baliknya umumnya boleh memakai data yang dikirim. Pakai jalur ini HANYA
# untuk dokumen sintetis. Jangan pernah mengirim kontrak Pertamina yang
# sebenarnya lewat sini.
#
# Kunci gratis: https://openrouter.ai/keys
# Batas tanpa membeli kredit: 20 permintaan per menit, 50 per hari.
OPENROUTER_API_KEY=

# Harus model yang mendukung structured outputs.
#
# Endpoint gratis diperebutkan banyak pengguna, sehingga model yang kemarin
# lancar bisa menolak dengan 429 hari ini walau kuota harian Anda masih utuh.
# Cari tahu mana yang sedang hidup dengan:
#   npx tsx --env-file=.env.local scripts/coba-model-openrouter.ts
#
# Bila model utama sibuk, sistem otomatis mencoba daftar cadangan di bawah,
# masing-masing sampai tiga kali dengan jeda menaik.
# Bawaan ini dipilih setelah diuji berulang: paling konsisten di antara
# model gratis. Yang lain sempat memberi hasil berbeda-beda pada dokumen
# yang sama walau suhu disetel nol.
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_MODEL_CADANGAN=dots-studio/dots-3-note-preview:free,openai/gpt-oss-20b:free,z-ai/glm-5.2:free

# ------------------------------------------------------------- Anthropic
# Kunci: https://console.anthropic.com/settings/keys
# Tidak ada model Anthropic yang gratis. Perkiraan biaya sekali ekstraksi
# untuk kontrak 24 halaman, hitung ulang dengan:
#   npx tsx scripts/hitung-biaya.ts
#
#   claude-haiku-4-5   Rp127   memadai untuk tugas menyalin nilai
#   claude-sonnet-5    Rp254   bila Haiku meleset pada medan tertentu
#   claude-opus-5      Rp635   paling mampu, untuk demonstrasi akhir
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
